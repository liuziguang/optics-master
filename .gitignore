# 数据与产物
*.zip
*.h5
*.hdf5
*.tif
*.tiff
*.raw
*_raw/
data/raw/
lab/*/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# 仿真的产物图与中间数据
sim/*/out/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# 临时
.tmp/
tmp/
*.log

# 密钥类
*.key
*.pem

# 私人信息（不进入公开仓库）
private/

# 本地书库：受版权保护的书籍与论文，只在本机使用，永不推送
library/*
!library/README.md

# 收件箱：截图等原始素材，只在本机保存，永不推送
inbox/*
!inbox/README.md

# Obsidian 的界面状态：每次动窗口都会变，不进仓库
# （app.json / appearance.json / core-plugins.json 这些设置文件保留跟踪）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
